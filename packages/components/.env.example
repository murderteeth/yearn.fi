# Optional. Enables the WalletConnect QR flow in the demo; injected browser
# wallets connect without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. Clusters name resolution for the connect button's wallet identity.
# Falls back to the public Clusters API when unset.
NEXT_PUBLIC_CLUSTERS_API_URL=
NEXT_PUBLIC_CLUSTERS_API_KEY=
