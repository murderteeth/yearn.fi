# Server-only. Required for the widget's zap quotes and balance discovery.
ENSO_API_KEY=

# Server-only. Spot prices. Falls back to the public prices service when unset.
YEARN_PRICES_BASE_URL=
YEARN_PRICES_API_KEY=

# Optional. Enables the WalletConnect QR flow in the demo; injected browser
# wallets connect without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
