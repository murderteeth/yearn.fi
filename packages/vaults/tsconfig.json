{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@yearn/util": ["../util/src/index.ts"],
      "@yearn/util/*": ["../util/src/*"],
      "@yearn/components": ["../components/src/index.ts"],
      "@yearn/components/*": ["../components/src/*"],
      "@yearn/vaults": ["./src/index.ts"],
      "@yearn/vaults/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts", "**/*.tsx"]
}
