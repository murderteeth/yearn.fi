{
  "name": "yearn-monorepo",
  "version": "0.3.7",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter yearnfi dev",
    "build": "bun run --filter yearnfi build",
    "build:all": "bun run --filter '*' build",
    "dev:components": "bun run --filter @yearn/components dev",
    "dev:deposit": "bun run --filter @yearn/deposit dev",
    "preview": "bun run --filter yearnfi preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "tslint": "bun run --filter '*' tslint",
    "test": "bun run --filter '*' test",
    "check:client-server-boundary": "bun run --filter yearnfi check:client-server-boundary",
    "clean": "bun run --filter yearnfi clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "typescript": "5.9.3"
  },
  "overrides": {
    "qr": "0.5.5"
  }
}
